NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3007
WEB_ORIGIN=http://localhost:3000

# Backend runtime role only. Replace with your dedicated project's connection.
DATABASE_URL=postgresql://archy_runtime.PROJECT_REF:REPLACE_RUNTIME_PASSWORD@POOLER_HOST:5432/postgres?schema=app&sslmode=verify-full

# Used only by the optional local PostgreSQL container.
POSTGRES_PASSWORD=replace-with-a-local-development-password
