# One-time setup for a NEW dedicated database. Never load this into the API.
# Use the IPv4 session pooler (5432), or the direct connection if IPv6 is available.
BOOTSTRAP_DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ADMIN_PASSWORD@POOLER_HOST:5432/postgres?schema=app&sslmode=verify-full
# Generate separate random passwords of at least 24 characters and URL-encode
# them when constructing the runtime/migration connection strings.
MIGRATION_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
RUNTIME_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
